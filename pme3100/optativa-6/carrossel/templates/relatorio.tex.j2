\textbf{Referenciais.} O referencial fixo é $(O,\vb{i},\vb{j},\vb{k})$, com $\vb{k}$ vertical
e $O$ no centro do carrossel. O referencial móvel tem a mesma origem e gira com o carrossel,
com $\vb*{\omega} = \omega(t)\,\vb{k}$ e $\vb*{\alpha} = \dot{\vb*{\omega}} = \alpha(t)\,\vb{k}$.
A base polar móvel tem $\vb{e}_r$ ao longo da reta da formiga e
$\vb{e}_\varphi = \vb{k}\wedge\vb{e}_r$. Por serem solidários ao carrossel,
\begin{equation}
\frac{\mathrm{d}\vb{e}_r}{\mathrm{d}t} = \vb*{\omega}\wedge\vb{e}_r = \omega\,\vb{e}_\varphi,
\qquad
\frac{\mathrm{d}\vb{e}_\varphi}{\mathrm{d}t} = \vb*{\omega}\wedge\vb{e}_\varphi = -\omega\,\vb{e}_r .
\label{eq:base}
\end{equation}

\textbf{Posição.} $\vb{OF} = r(t)\,\vb{e}_r(t)$, com $\dot r = -v$ (a formiga anda rumo a $O$
com velocidade relativa de módulo $v$) e $\dot\varphi = \omega$ (a reta é fixa no carrossel).

\textbf{Velocidade.} Derivando $\vb{OF}$ e usando \eqref{eq:base}:
\begin{equation}
\vb{v}_{\mathrm{abs}} = \dot r\,\vb{e}_r + r\,\dot{\vb{e}}_r
= \underbrace{-v\,\vb{e}_r}_{\vb{v}_{\mathrm{rel}}}
+ \underbrace{\omega r\,\vb{e}_\varphi}_{\vb{v}_{\mathrm{arr}} = \vb*{\omega}\wedge\vb{OF}} .
\label{eq:vel}
\end{equation}
A velocidade relativa é a vista por um observador no carrossel (para quem $\vb{e}_r$ é fixo); a
de arrastamento é a do ponto do carrossel que coincide com $F$ no instante.

\textbf{Aceleração.} Derivando \eqref{eq:vel} mais uma vez, com $\dot\omega = \alpha$:
\begin{align}
\vb{a}_{\mathrm{abs}}
&= -\dot v\,\vb{e}_r - v\omega\,\vb{e}_\varphi + (\alpha r + \omega\dot r)\,\vb{e}_\varphi - \omega^2 r\,\vb{e}_r \nonumber\\
&= \underbrace{-\dot v\,\vb{e}_r}_{\vb{a}_{\mathrm{rel}}}
 + \underbrace{\alpha r\,\vb{e}_\varphi}_{\vb*{\alpha}\wedge\vb{OF}}
 + \underbrace{(-\omega^2 r)\,\vb{e}_r}_{\vb*{\omega}\wedge(\vb*{\omega}\wedge\vb{OF})}
 + \underbrace{(-2\omega v)\,\vb{e}_\varphi}_{\vb{a}_{\mathrm{cor}} = 2\vb*{\omega}\wedge\vb{v}_{\mathrm{rel}}} .
\label{eq:acc}
\end{align}
A aceleração de arrastamento tem duas parcelas: a \emph{tangencial} $\vb*{\alpha}\wedge\vb{OF}$,
que só existe se o carrossel acelera, e a \emph{centrípeta} $\vb*{\omega}\wedge(\vb*{\omega}\wedge\vb{OF})$,
que aponta para $O$. Como $O$ é fixo, $\vb{a}_O = \vb{0}$ e não há outra parcela.

\begin{nota}[unbreakable]
\textbf{Resumo do modelo} (composição de movimentos):\\[0.3em]
$\begin{aligned}
\vb{v}_{\mathrm{rel}} &= -v\,\vb{e}_r, &
\vb{v}_{\mathrm{arr}} &= \vb*{\omega}\wedge\vb{OF} = \omega r\,\vb{e}_\varphi, &
\vb{v}_{\mathrm{abs}} &= \vb{v}_{\mathrm{rel}} + \vb{v}_{\mathrm{arr}};\\
\vb{a}_{\mathrm{rel}} &= -\dot v\,\vb{e}_r, &
\vb{a}_{\mathrm{arr}} &= \alpha r\,\vb{e}_\varphi - \omega^2 r\,\vb{e}_r, &
\vb{a}_{\mathrm{cor}} &= 2\vb*{\omega}\wedge\vb{v}_{\mathrm{rel}} = -2\omega v\,\vb{e}_\varphi;\\
&& \vb{a}_{\mathrm{abs}} &= \vb{a}_{\mathrm{rel}} + \vb{a}_{\mathrm{arr}} + \vb{a}_{\mathrm{cor}}.
\end{aligned}$\\[0.3em]
Na base fixa, $\vb{e}_r = \cos\varphi\,\vb{i} + \sin\varphi\,\vb{j}$ e
$\vb{e}_\varphi = -\sin\varphi\,\vb{i} + \cos\varphi\,\vb{j}$.
\end{nota}

%# ============================================================== (a) LEI DE MOVIMENTO
\section{(a) Lei de movimento}\label{sec:lei}
Esta seção integra $\dot r = -v$ e $\dot\varphi = \omega$ desde $t = 0$, com $r(0) = R$ e
$\varphi(0) = \varphi_0$, e obtém o instante $t_f$ em que a formiga chega ao centro.

\begin{equation*}
r(t) = R - \int_0^t v(\tau)\,\mathrm{d}\tau, \qquad
\varphi(t) = \varphi_0 + \int_0^t \omega(\tau)\,\mathrm{d}\tau, \qquad
\vb{OF}(t) = r(t)\,\vb{e}_r(t) = x(t)\,\vb{i} + y(t)\,\vb{j}.
\end{equation*}

\BLOCK{if mov.simbolico}
Com $\omega(t) = \VAR{lx.omega_dec}$\,\unit{rad/s} e $v(t) = \VAR{lx.v_dec}$\,\unit{m/s}, as
integrais têm forma fechada (calculadas em aritmética exata com o \texttt{sympy}):
\begin{align*}
r(t) &= \VAR{lx.r} \quad [\unit{m}],\\
\varphi(t) &= \VAR{lx.phi} \quad [\unit{rad}],\\
x(t) &= r(t)\cos\varphi(t), \qquad y(t) = r(t)\sin\varphi(t) \quad [\unit{m}].
\end{align*}
\BLOCK{else}
\begin{alerta}
\textbf{Lei obtida numericamente.} O \texttt{sympy} não encontrou forma fechada para as
integrais de $v(t) = \VAR{lx.v_dec}$ e/ou de $\omega(t) = \VAR{lx.omega_dec}$. Por isso
$r(t)$ e $\varphi(t)$ foram obtidas integrando $\dot r = -v$, $\dot\varphi = \omega$ com
o método de Dormand–Prince de 8.ª ordem (DOP853, tolerâncias relativa e absoluta de
$10^{-12}$), com interpolação contínua. Velocidades e acelerações continuam usando
$\omega$, $\alpha$, $v$ e $\dot v$ exatas.
\end{alerta}
\BLOCK{endif}
Derivadas usadas em (c): $\alpha(t) = \dot\omega = \VAR{lx.alpha_dec}$\,\unit{rad/s^2} e
$\dot v(t) = \VAR{lx.vdot_dec}$\,\unit{m/s^2}.

\BLOCK{if mov.chegou}
\textbf{Fim do movimento.} $t_f$ é a raiz de $r(t_f) = 0$, obtida pelo método de Brent no
primeiro intervalo em que $r$ muda de sinal: $t_f = \VAR{n(mov.t_f)}$\,s, com
$\varphi(t_f) = \VAR{n(mov.phi(mov.t_f))}$\,rad. Depois disso a formiga está no centro e o
movimento termina.
\BLOCK{else}
\textbf{Fim do movimento.} $r(t)$ não se anula até $t_{\max} = \VAR{n(mov.t_f)}$\,s: a
formiga não chega ao centro nesse horizonte, e a análise para em $t_{\max}$.
\BLOCK{endif}

