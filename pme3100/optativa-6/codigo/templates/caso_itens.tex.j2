%# ============================================================== (a) LEI DE MOVIMENTO
%# Barreira explícita: placeins só age em \section, e no conjunto os itens são subseções.
\FloatBarrier
\VAR{H}{(a) Lei de movimento}\label{sec:lei-\VAR{nome}}
Esta seção integra $\dot r = -v$ e $\dot\varphi = \omega$ desde $t = 0$, com $r(0) = R$ e
$\varphi(0) = \varphi_0$, e obtém o instante $t_f$ em que a formiga chega ao centro.

\begin{equation*}
r(t) = R - \int_0^t v(\tau)\,\mathrm{d}\tau, \qquad
\varphi(t) = \varphi_0 + \int_0^t \omega(\tau)\,\mathrm{d}\tau, \qquad
\vb{OF}(t) = r(t)\,\vb{e}_r(t) = x(t)\,\vb{i} + y(t)\,\vb{j}.
\end{equation*}

\BLOCK{if mov.simbolico}
Com $\omega(t) = \VAR{lx.omega_dec}$\,\unit{rad/s} e $v(t) = \VAR{lx.v_dec}$\,\unit{m/s}, as
integrais têm forma fechada (calculadas em aritmética exata com o \texttt{sympy}):
\begin{align*}
r(t) &= \VAR{lx.r} \quad [\unit{m}],\\
\varphi(t) &= \VAR{lx.phi} \quad [\unit{rad}],\\
x(t) &= r(t)\cos\varphi(t), \qquad y(t) = r(t)\sin\varphi(t) \quad [\unit{m}].
\end{align*}
\BLOCK{else}
\begin{alerta}
\textbf{Lei obtida numericamente.} O \texttt{sympy} não encontrou forma fechada para as
integrais de $v(t) = \VAR{lx.v_dec}$ e/ou de $\omega(t) = \VAR{lx.omega_dec}$. Por isso
$r(t)$ e $\varphi(t)$ foram obtidas integrando $\dot r = -v$, $\dot\varphi = \omega$ com
o método de Dormand–Prince de 8.ª ordem (DOP853, tolerâncias relativa e absoluta de
$10^{-12}$), com interpolação contínua. Velocidades e acelerações continuam usando
$\omega$, $\alpha$, $v$ e $\dot v$ exatas.
\end{alerta}
\BLOCK{endif}
Derivadas usadas em (c): $\alpha(t) = \dot\omega = \VAR{lx.alpha_dec}$\,\unit{rad/s^2} e
$\dot v(t) = \VAR{lx.vdot_dec}$\,\unit{m/s^2}.

\BLOCK{if mov.chegou}
\textbf{Fim do movimento.} $t_f$ é a raiz de $r(t_f) = 0$, obtida pelo método de Brent no
primeiro intervalo em que $r$ muda de sinal: $t_f = \VAR{n(mov.t_f)}$\,s, com
$\varphi(t_f) = \VAR{n(mov.phi(mov.t_f))}$\,rad. Depois disso a formiga está no centro e o
movimento termina.
\BLOCK{else}
\textbf{Fim do movimento.} $r(t)$ não se anula até $t_{\max} = \VAR{n(mov.t_f)}$\,s: a
formiga não chega ao centro nesse horizonte, e a análise para em $t_{\max}$.
\BLOCK{endif}

