\section{Curva espacial e triedro de Frenet}

\subsection{A curva (2.1)}
$\vb{r}(\lambda) = (\lambda,\ \lambda^2,\ \lambda^3)$ é a \emph{cúbica reversa}. As derivadas são
\[
\vb{r}' = (1,\ 2\lambda,\ 3\lambda^2),\quad \vb{r}'' = (0,\ 2,\ 6\lambda),\quad \vb{r}''' = (0,\ 0,\ 6),
\quad \vb{r}'\times\vb{r}'' = (6\lambda^2,\ -6\lambda,\ 2).
\]
Como $\vb{r}'\times\vb{r}''$ nunca se anula, a curva tem curvatura em todo ponto, e a torção
nunca se anula: ela não fica contida em nenhum plano.

\begin{figure}[H]
\centering
\includegraphics{\VAR{dir}/espacial.pdf}
\caption{A cúbica reversa, com os pontos escolhidos.}
\end{figure}

\subsection{Raio de curvatura (2.2)}
\[
\kappa = \frac{|\vb{r}'\times\vb{r}''|}{|\vb{r}'|^3}, \qquad
\rho = \frac1\kappa = \frac{(1 + 4\lambda^2 + 9\lambda^4)^{3/2}}{2\sqrt{1 + 9\lambda^2 + 9\lambda^4}}, \qquad
\tau_\mathrm{tor} = \frac{(\vb{r}'\times\vb{r}'')\cdot\vb{r}'''}{|\vb{r}'\times\vb{r}''|^2} = \frac{3}{1 + 9\lambda^2 + 9\lambda^4}.
\]

