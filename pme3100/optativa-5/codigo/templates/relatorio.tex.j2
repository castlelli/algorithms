\end{tabular}
\end{center}

\subsection{Triedro de Frenet (2.3)}
\[
\boldsymbol{\tau} = \frac{\vb{r}'}{|\vb{r}'|},\qquad
\vb{b} = \frac{\vb{r}'\times\vb{r}''}{|\vb{r}'\times\vb{r}''|},\qquad
\vb{n} = \vb{b}\times\boldsymbol{\tau}.
\]

